<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!-- Chuyển LiDAR về phía sau thân xe (x=-0.15m, z=0.076m) đổi chỗ cho thùng hàng -->
    <origin xyz="-0.15 0 0.076" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <!-- Đế gắn bulông kim loại tiếp xúc mặt sàn xe (z = 0.06m đến 0.068m) -->
    <visual>
      <origin xyz="0 0 -0.012" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.008"/>
      </geometry>
      <material name="lidar_base_mat">
        <color rgba="0.18 0.20 0.24 1.0"/>
      </material>
    </visual>
    <!-- Tháp quay quét quang học LiDAR (màu ngọc lam) -->
    <visual>
      <origin xyz="0 0 0.001" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.034" length="0.018"/>
      </geometry>
      <material name="lidar_mat">
        <color rgba="0.1 0.7 0.9 1.0"/>
      </material>
    </visual>
    <!-- Vòng khe quang học phát laser màu đen -->
    <visual>
      <origin xyz="0 0 0.002" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.007"/>
      </geometry>
      <material name="lidar_slit_mat">
        <color rgba="0.08 0.08 0.08 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.002" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.028"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.002" rpy="0 0 0"/>
      <mass value="0.12"/>
      <xacro:cyl_inertia_z m="0.12" r="0.038" h="0.028"/>
    </inertial>
  </link>

  <gazebo reference="lidar_link">
    <material>Gazebo/Turquoise</material>
    <sensor name="lidar" type="ray">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.38</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <xacro:box_inertia m="0.02" x="0.02" y="0.02" z="0.01"/>
    </inertial>
  </link>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.001</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ======================================================== -->
  <!-- ======================================================== -->
  <!-- DOCK CAMERA (Gắn cố định trên thân xe, z=0.23m, nhìn ngang) -->
  <!-- ======================================================== -->
  <joint name="dock_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="dock_camera_link"/>
    <!-- Tâm quang học đặt cố định trên thân xe tại z=0.23m (cách đất), hướng ngang thẳng trước (0 deg) căn giữa đối xứng hoàn hảo cả tầng 1 (z=0.11m, dZ=-0.12m) và tầng 2 (z=0.36m, dZ=+0.13m) -->
    <origin xyz="0.19 0.0 0.14" rpy="0 0 0"/>
  </joint>

  <link name="dock_camera_link">
    <!-- Giá đỡ kim loại gắn chặt vào thân toa trượt -->
    <visual>
      <origin xyz="-0.025 0 -0.017" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.016 0.024"/>
      </geometry>
      <material name="cam_bracket">
        <color rgba="0.2 0.22 0.25 1.0"/>
      </material>
    </visual>
    <!-- Thân vỏ camera -->
    <visual>
      <origin xyz="-0.017 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.040 0.025"/>
      </geometry>
      <material name="cam_body">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <!-- Ống kính camera hướng về phía trước (+x) -->
    <visual>
      <origin xyz="-0.002 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.008"/>
      </geometry>
      <material name="cam_lens">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
    <inertial>
      <origin xyz="-0.025 0 -0.005" rpy="0 0 0"/>
      <mass value="0.05"/>
      <xacro:box_inertia m="0.05" x="0.03" y="0.05" z="0.03"/>
    </inertial>
  </link>

  <joint name="dock_camera_optical_joint" type="fixed">
    <parent link="dock_camera_link"/>
    <child link="dock_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <link name="dock_camera_optical_frame"/>

  <gazebo reference="dock_camera_link">
    <material>Gazebo/Black</material>
    <selfCollide>false</selfCollide>
    <sensor name="dock_camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.3963</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>5.0</far>
        </clip>
      </camera>
      <plugin name="dock_camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
        </ros>
        <camera_name>dock_camera</camera_name>
        <frame_name>dock_camera_optical_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ======================================================== -->
  <!-- ======================================================== -->
  <!-- HAND CAMERA (Gắn trên đế tay kẹp bẻ ngang, nhìn về phía trước) -->
  <!-- ======================================================== -->
  <joint name="hand_camera_joint" type="fixed">
    <parent link="tool_link"/>
    <child link="hand_camera_link"/>
    <!-- Gắn trên sống lưng khớp bẻ ngang, nhìn theo phương +X và chúi nhẹ 12.6 độ xuống hộp -->
    <origin xyz="0.006 0.0 -0.038" rpy="0 0.22 0"/>
  </joint>

  <link name="hand_camera_link">
    <!-- Ngàm đỡ bắt bulông vào mặt sau đế tay kẹp (nằm phía sau sensor) -->
    <visual>
      <origin xyz="-0.015 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.016 0.032 0.016"/>
      </geometry>
      <material name="cam_bracket"/>
    </visual>
    <!-- Thân vỏ camera (nằm phía sau sensor) -->
    <visual>
      <origin xyz="-0.005 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.020 0.036 0.020"/>
      </geometry>
      <material name="cam_body"/>
    </visual>
    <!-- Ống kính nhìn thẳng theo trục quang học -->
    <visual>
      <origin xyz="0.005 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.007" length="0.006"/>
      </geometry>
      <material name="cam_lens"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.04"/>
      <xacro:box_inertia m="0.04" x="0.025" y="0.04" z="0.025"/>
    </inertial>
  </link>

  <joint name="hand_camera_optical_joint" type="fixed">
    <parent link="hand_camera_link"/>
    <child link="hand_camera_optical_frame"/>
    <origin xyz="0.010 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <link name="hand_camera_optical_frame"/>

  <gazebo reference="hand_camera_link">
    <material>Gazebo/Black</material>
    <selfCollide>false</selfCollide>
    <sensor name="hand_camera" type="camera">
      <pose>0.010 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.2</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.01</near>
          <far>5.0</far>
        </clip>
      </camera>
      <plugin name="hand_camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
        </ros>
        <camera_name>hand_camera</camera_name>
        <frame_name>hand_camera_optical_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
