<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="warehouse_robot">

  
  <xacro:arg name="params_file" default="/home/lehuythien/warehouse_ws/src/wh_description/config/robot_params.yaml"/>
  <xacro:property name="p" value="${xacro.load_yaml('$(arg params_file)')}"/>

  
  <xacro:include filename="inertia_macros.xacro"/>
  <xacro:include filename="base.xacro"/>
  <xacro:include filename="mecanum_wheel.xacro"/>
  <xacro:include filename="arm.xacro"/>
  <xacro:include filename="sensors.xacro"/>
  <xacro:include filename="gazebo_plugins.xacro"/>
  <xacro:include filename="ros2_control.xacro"/>

</robot>
